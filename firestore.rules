rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Доступ только из приложения (анонимный вход) и только к своей команде.
    // Код команды — длинный случайный, его знают только те, кому прислали ссылку.
    match /teams/{team}/{document=**} {
      allow read, write: if request.auth != null && team.size() >= 16;
    }
  }
}
