rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Доступ к данным команды есть только у её участников.
    // Стать участником можно только с действующим ключом из ссылки-приглашения.
    // Админ может убрать человека и сменить ключ — тогда по старой ссылке не войти.
    function authed() { return request.auth != null; }
    function codeOk(c) { return c is string && c.matches('^[a-z0-9]{16,40}$'); }
    function teamRef(team) { return /databases/$(database)/documents/teams/$(team); }
    function memberRef(team, uid) { return /databases/$(database)/documents/teams/$(team)/members/$(uid); }
    function isMember(team) { return authed() && codeOk(team) && exists(memberRef(team, request.auth.uid)); }
    function isAdmin(team) { return isMember(team) && request.auth.uid in get(teamRef(team)).data.admins; }
    function strMax(d, key, n) { return !(key in d) || (d[key] is string && d[key].size() <= n); }
    function mapMax(d, key, n) { return !(key in d) || (d[key] is map && d[key].size() <= n); }
    function teamShape(d) {
      return d.keys().hasOnly(['admins', 'joinKey', 'createdAt'])
        && d.admins is list && d.admins.size() >= 1 && d.admins.size() <= 10
        && codeOk(d.joinKey);
    }

    // Карточка команды: список админов и текущий ключ приглашения.
    match /teams/{team} {
      allow read: if isMember(team);
      allow create: if authed() && codeOk(team) && teamShape(request.resource.data)
        && request.resource.data.admins == [request.auth.uid];
      allow update: if isAdmin(team) && teamShape(request.resource.data);
      allow delete: if false;
    }

    // Участники: войти можно только с текущим ключом; свою карточку правит сам человек,
    // убрать из команды может он сам или админ.
    match /teams/{team}/members/{mid} {
      allow read: if isMember(team);
      allow create: if authed() && codeOk(team) && mid == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'joinedAt', 'lastSeen', 'key'])
        && strMax(request.resource.data, 'name', 40)
        && request.resource.data.lastSeen is number
        && request.resource.data.key == getAfter(teamRef(team)).data.joinKey;
      allow update: if authed() && codeOk(team) && mid == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'joinedAt', 'lastSeen', 'key'])
        && strMax(request.resource.data, 'name', 40)
        && request.resource.data.lastSeen is number
        && request.resource.data.key == resource.data.key;
      allow delete: if authed() && codeOk(team) && (mid == request.auth.uid || isAdmin(team));
    }

    match /teams/{team}/services/{sid} {
      allow read, delete: if isMember(team);
      allow create, update: if isMember(team)
        && sid.matches('^s[a-z0-9]{6,30}$')
        && request.resource.data.keys().hasOnly(['date', 'title', 'notes', 'lineup', 'mon', 'packed', 'updatedAt', 'updatedByName'])
        && strMax(request.resource.data, 'date', 10)
        && strMax(request.resource.data, 'title', 120)
        && strMax(request.resource.data, 'notes', 2000)
        && strMax(request.resource.data, 'updatedByName', 60)
        && (!('lineup' in request.resource.data) || (request.resource.data.lineup is list && request.resource.data.lineup.size() <= 80))
        && mapMax(request.resource.data, 'mon', 4)
        && mapMax(request.resource.data, 'packed', 40)
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is number);
    }

    match /teams/{team}/meta/inventory {
      allow read: if isMember(team);
      allow create, update: if isMember(team)
        && request.resource.data.keys().hasOnly(['stock', 'spare'])
        && mapMax(request.resource.data, 'stock', 40)
        && mapMax(request.resource.data, 'spare', 4);
    }
    // Всё остальное закрыто.
  }
}
